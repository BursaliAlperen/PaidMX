rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PaidMX: tüm yazma/okuma Cloud Functions Admin SDK üzerinden yapılır.
    // İstemci SDK erişimi varsayılan olarak tamamen kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
