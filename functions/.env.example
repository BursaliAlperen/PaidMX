# functions/.env.paidmx dosyasına karşılık gelen sunucu tarafı ayarlar.
# Bu dosyayı .env.paidmx adıyla kopyalayıp gerçek değerleri yerel ortamda girin.
# .env.paidmx dosyasını ASLA Git'e commit etmeyin.

# Telegram BotFather token'ı Cloud Functions Secret Manager'da saklanmalı.
# Kurulum: firebase functions:secrets:set BOT_TOKEN
# BOT_TOKEN=  # Buraya token yazmayın / bu dosyayı deploy etmeyin.

# Virgülle ayrılmış Telegram numeric user ID listesi.
ADMIN_IDS=7904032877

# Stormkit'te deploy edilen frontend origin'ini tam olarak girin.
CORS_ORIGINS=https://YOUR-STORMKIT-DOMAIN
