# Stormkit frontend environment (public value only)
# Firebase HTTPS API deploy edildikten sonra gerçek endpoint'i girin.
VITE_API_URL=https://us-central1-paidmx.cloudfunctions.net/api

# BOT_TOKEN ve ADMIN_IDS burada OLMAMALI.
# BOT_TOKEN Firebase Secret Manager'da; ADMIN_IDS yalnızca Cloud Functions
# runtime ortamında (functions/.env.paidmx) tutulmalıdır.
